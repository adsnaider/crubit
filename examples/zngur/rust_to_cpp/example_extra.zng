// Hand-written additions to the generated `.zng` file (`extra_zng`), which the
// generated file merges: here, `Rect::aspect_ratio`, which returns a generic type
// (`Option<i32>`) that crubit doesn't describe yet.

type bool {
    #layout(size = 1, align = 1);
    wellknown_traits(Copy);
}

type ::core::option::Option<i32> {
    #layout(size = 8, align = 4);
    wellknown_traits(Copy);

    fn is_some(&self) -> bool;
    fn unwrap(self) -> i32;
}

type ::example::Rect {
    fn aspect_ratio(&self) -> ::core::option::Option<i32>;
}
